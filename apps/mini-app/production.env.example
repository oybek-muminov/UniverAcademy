# PUBLIC production build inputs. Apply only after the activation review.
# This example is not loaded by Vite automatically. No secret credentials here.
# Origins have HTTPS scheme and host only; no /api/v1, query, fragment or userinfo.
VITE_MINI_APP_ORIGIN=https://mini.univeracademy.uz
VITE_API_ORIGIN=https://api.univeracademy.uz
VITE_STUDENT_CONTRACT_SHA256=430a2be52599c46f49ef1263ff579cd5c993954f62b7a37fd1a10814c8d05455
# common selects Clerk's provided SignIn form; blank/unknown stays closed.
# Custom credential UI remains test/reserve only; no automatic production fallback.
VITE_AUTH_ENTRY=common
# SDK enablement remains a separately reviewed production activation.
VITE_CLERK_SDK_ENABLED=true
# Verified production publishable key and Frontend API. Never add sk_live here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudW5pdmVyYWNhZGVteS51eiQ
VITE_CLERK_FRONTEND_ORIGIN=https://clerk.univeracademy.uz
# Official SDK head script for exact signed Telegram launch proof.
VITE_TELEGRAM_SDK_ENABLED=true

{
  "name": "univeracademy-api",
  "main": "runtime/cloudflare-worker.mjs",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  },
  "hyperdrive": [
    {"binding": "HYPERDRIVE", "id": "075d873d9cdd4ad48a027b5e5a6f7acf"}
  ],
  "vars": {"UA_TELEGRAM_LOOKUP_TIMEOUT_MS": "3000"}
  // INACTIVE LOOKUP-ONLY CANDIDATE. Reuses the existing Hyperdrive resource.
  // Omitting UA_TELEGRAM_START_MODE selects the reviewed database default.
  // Full Clerk HTTP configuration and activation remain separate gates.
  // Bot service binding: TELEGRAM_START_LOOKUP -> univeracademy-api,
  // named entrypoint TelegramAccountDirectory (not default).
}

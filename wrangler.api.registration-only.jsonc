{
  "name": "univeracademy-api",
  "main": "runtime/cloudflare-worker.mjs",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.univeracademy.uz", "custom_domain": true }],
  "keep_vars": true,
  // The three Hyperdrive bindings use the same Supabase project in Ireland.
  "placement": { "region": "aws:eu-west-1" },
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  },
  "hyperdrive": [
    {"binding": "HYPERDRIVE", "id": "075d873d9cdd4ad48a027b5e5a6f7acf"},
    {"binding": "CABINET_HYPERDRIVE", "id": "3b8bc95acda546bf804d36678a1b37a3"},
    {"binding": "TEACHER_PILOT_HYPERDRIVE", "id": "ac6d5e78608a4004b67e5c6bdc6a2936"}
  ],
  "services": [{ "binding": "TELEGRAM_MENU_SYNC", "service": "univeracademy-bot", "entrypoint": "TelegramMenuSync" }],
  "vars": {
    "UA_TELEGRAM_MENU_SYNC_ENABLED": "true",
    "UA_API_ORIGIN": "https://api.univeracademy.uz",
    "UA_ALLOWED_ORIGINS": "[\"https://mini.univeracademy.uz\"]",
    "UA_SESSION_POLICY": "{\"initDataMaxAgeSeconds\":300,\"futureSkewSeconds\":0,\"accessTtlMs\":900000,\"familyTtlMs\":86400000,\"logoutTombstoneMs\":86400000,\"identityCollisionAttempts\":4,\"newLogin\":\"revoke_previous\"}",
    "UA_CLERK_PROVIDER_SETTINGS": "{\"issuer\":\"https://clerk.univeracademy.uz\",\"authorizedParties\":[\"https://mini.univeracademy.uz\"],\"audience\":{\"kind\":\"clerk_default_no_audience\"},\"jwksCacheMs\":60000,\"jwksCooldownMs\":5000,\"timeoutMs\":3000,\"maxJwksBytes\":65536}",
    "UA_TELEGRAM_LOOKUP_TIMEOUT_MS": "3000"
  }
  // Registration, cabinet and Telegram delivery each use their own restricted connection.
  // Preserve separately reviewed dashboard vars during main auto-deploys.
  // keep_vars does not replace explicit resource bindings or provision secrets.
  // Omitting UA_TELEGRAM_START_MODE selects the reviewed database default.
  // Public Clerk-first settings are pinned; secrets remain platform-only.
  // Publication requires independently reviewed activation and real-account gates.
  // Bot service binding: TELEGRAM_START_LOOKUP -> univeracademy-api,
  // named entrypoint TelegramAccountDirectory (not default).
}
